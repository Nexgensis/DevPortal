# Copy to .env beside docker-compose.yml and fill in real values.
# .env is gitignored — never commit it, and never put real secrets in
# docker-compose.yml (that file is committed and its history is permanent).

# --- Database ---------------------------------------------------------------
# Used for both the postgres container and the backend's DB_DSN.
POSTGRES_PASSWORD=

# --- Crypto (required; the backend refuses to start without these) -----------
# Signs JWTs. Rotating it invalidates every issued token, i.e. logs everyone out.
#   openssl rand -base64 32
JWT_SECRET=

# Encrypts Docker client TLS keys and PostgreSQL passwords at rest.
# MUST be exactly 16, 24 or 32 bytes (32 = AES-256).
#   openssl rand -hex 16     # 32 characters
#
# WARNING: changing this makes every already-stored server TLS key and DB
# password undecryptable. Re-enter them in the UI after rotating.
ENCRYPTION_KEY=

# --- HTTP -------------------------------------------------------------------
GIN_MODE=release
FRONTEND_URL=https://portal.example.com
# Comma-separated CORS allowlist. Defaults to FRONTEND_URL when unset.
CORS_ALLOWED_ORIGINS=https://portal.example.com

# --- Microsoft Entra ID SSO -------------------------------------------------
SSO_ENABLED=true
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://portal.example.com/api/auth/microsoft/callback
SSO_AUTO_CREATE_USERS=true
SSO_DEFAULT_ROLE=user
# Comma-separated emails granted the admin role on first SSO login.
SSO_ADMIN_EMAILS=

# --- Break-glass admin (fresh database only) --------------------------------
# Seeded only when the users table is empty. Leave ADMIN_PASSWORD blank and the
# backend generates a strong one and prints it once in the first-boot logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Sonatype Nexus (security scan reports; optional) -----------------------
# Leave NEXUS_URL empty to keep the scan-report fetcher idle.
NEXUS_URL=
NEXUS_USER=
NEXUS_PASS=
